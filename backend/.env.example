# Server
PORT=5000
NODE_ENV=development

# Local MongoDB (default database: sookshop)
MONGO_URI=mongodb://127.0.0.1:27017/sookshop

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# First admin account — created/reset with `npm run seed:admin`
ADMIN_NAME=Sookshop Admin
ADMIN_EMAIL=admin@sookshop.com
ADMIN_PASSWORD=Admin@123

# React apps (used by CORS)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
